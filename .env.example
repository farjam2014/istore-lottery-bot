NODE_ENV=production
BOT_TOKEN=
BOT_MODE=polling
BOT_ADMIN_IDS=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=istore_lottery
MYSQL_USER=istore_bot
MYSQL_PASSWORD=
MYSQL_POOL_SIZE=10
LOG_LEVEL=info
# Legacy single-key fallback. Keep configured while any prepared draw uses seed_key_id=legacy-env.
DRAW_SEED_ENCRYPTION_KEY=
# Preferred keyring JSON: {"key-id":"64-hex-character-key"}. Keep old keys until no prepared draw references them.
DRAW_SEED_ENCRYPTION_KEYS=
# Must match one key ID in DRAW_SEED_ENCRYPTION_KEYS. Defaults to legacy-env.
DRAW_SEED_ACTIVE_KEY_ID=legacy-env

# Publish and review this notice before collecting participant data.
PRIVACY_NOTICE_URL=https://example.com/privacy
PRIVACY_NOTICE_VERSION=2026-11-24-v1
